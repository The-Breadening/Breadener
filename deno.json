{
  "tasks": {
    "copy-dev": "cp ../Breadener-token/dev.env .env",
    "copy-prod": "cp ../Breadener-token/prod.env .env",
    "prod": "deno run -A src/index.ts",
    "prod-db": "rm daataabaasaa.db; deno run -A src/db.ts; deno run dev",
    "dev": "deno run -A --unstable-kv --env-file=.env --watch src/index.ts",
    "dev-db": "rm daataabaasaa.db; deno run -A src/db.ts; deno run dev-watch"
  },
  "imports": {
    "$src/": "./src/",
    "$utils/": "./src/utils/",
    "$static/": "./static/",
    "$events/": "./src/events/",

    "discord.js": "npm:discord.js@^14.25.1"
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsr"],
      "include": [
        "camelCase",
        "eqeqeq",
        "explicit-function-return-type",
        "no-const-reassign",
        "no-eval"
      ]
    }
  },
  "fmt": {
    "bracePosition": "sameLine",
    "singleQuote": false,
    "semiColons": true,
    "operatorPosition": "nextLine",
    "useBraces": "whenNotSingleLine"
  },
  "deploy": {
    "org": "killioiden",
    "app": "breadener"
  }
}
